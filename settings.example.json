{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git clone --depth=* --config core.hooksPath=/dev/null -- *)",

      "Bash(gh pr view *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checkout *)",
      "Bash(*gh-fetch-review-comments.sh *)",
      "Bash(*gh-fetch-reviews.sh *)",
      "Bash(*gh-list-review-threads.sh *)",
      "Bash(*gh-resolve-review-thread.sh *)",
      "Bash(*gh-request-reviewer.sh *)",
      "Bash(*gh-post-review.sh *)",
      "Bash(*gh-pr-base-sha.sh *)",
      "Bash(*diff-anchors.py *)",
      "Bash(gh api /advisories*)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",

      "Bash(govulncheck *)",
      "Bash(cargo audit *)",
      "Bash(npm audit *)",
      "Bash(pip-audit *)",

      "Bash(rm -rf /tmp/claude/*)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push*--force-with-lease*)",
      "Bash(git push*-f *)",
      "Bash(git push*-f)",
      "Bash(git push*+*:*)",
      "Bash(git push*--delete*)",
      "Bash(git push*-d *)",
      "Bash(git push origin :*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)"
    ]
  }
}
